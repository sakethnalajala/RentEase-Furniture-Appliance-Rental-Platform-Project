{
  "version": 2,
  "builds": [
    { "src": "backend/api/index.js", "use": "@vercel/node", "config": { "maxDuration": 60 } },
    { "src": "frontend/package.json", "use": "@vercel/next" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ]
}
