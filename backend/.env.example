# ---- Core (required) ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27117/rentease

# ---- Demo Mode ----
# true (default): skips mandatory email verification on register and accepts any 6-digit
# OTP code for phone login (auto-creating an account if the phone isn't registered yet) —
# lets the whole app be demoed with fake emails/phones and no SMTP/SMS provider.
# Set to false for anything resembling a real deployment.
DEMO_MODE=true

# ---- JWT ----
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- Email verification / password reset token secret ----
EMAIL_TOKEN_SECRET=change_this_email_token_secret

# ---- SMTP (optional — falls back to console-logged emails in dev) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RentEase <no-reply@rentease.com>"

# ---- Twilio SMS/WhatsApp (optional — falls back to console-logged OTP/SMS in dev) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# ---- Google OAuth (optional — Google login route is skipped if absent) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ---- Cloudinary (optional — falls back to local/no-op storage in dev) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Razorpay (optional — falls back to a mocked payment flow in dev) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Firebase Cloud Messaging (optional — push notifications log to console in dev) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
