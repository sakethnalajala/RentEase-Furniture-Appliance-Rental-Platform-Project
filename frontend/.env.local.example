# Base URL of the backend REST API (Socket.IO connects to the same origin).
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Production (Vercel → Settings → Environment Variables, Production + Preview), then redeploy —
# NEXT_PUBLIC_* values are baked in at build time:
#   NEXT_PUBLIC_API_URL=https://<your-render-service>.onrender.com/api/v1
